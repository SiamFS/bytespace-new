{
  "name": "bytespace-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run fonts && next dev",
    "build": "npm run fonts && next build",
    "start": "next start",
    "lint": "eslint",
    "fonts": "node scripts/fetch-fonts.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "30.1.1",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
