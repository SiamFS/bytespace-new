# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=4000

# Postgres (local: docker compose up -d postgres). Production: Neon pooled URL (host has "-pooler").
DATABASE_URL=postgresql://bytespace:bytespace@localhost:5433/bytespace?schema=public
# Direct URL for migrations only. Production: Neon URL without "-pooler". Optional locally.
# DIRECT_URL=

# Redis for rate limits (local: docker compose up -d redis). Required on Vercel.
# Production: Upstash → rediss://default:<password>@<your-db>.upstash.io:6379
REDIS_URL=redis://localhost:6380

# Session signing key, 32+ characters: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters

# Website origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Google sign-in (optional — set both or neither). Google Cloud Console → Google Auth Platform →
# Clients → Web application. Authorized redirect URI = <first CORS_ORIGINS entry>/api/auth/google/callback,
# e.g. http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Verification emails (optional). Brevo → Settings → SMTP & API → API keys; EMAIL_FROM must be a
# verified Brevo sender. Without a key the link is logged and shown on the sign-up page instead.
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=ByteSpace

# Proxies in front of the API (0 locally)
TRUST_PROXY=0

LOG_LEVEL=info
BCRYPT_ROUNDS=12
# REGISTER_LIMIT_PER_HOUR=5
