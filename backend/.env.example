# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=4000

# docker compose up -d postgres  →  Postgres on localhost:5433 (see ../docker-compose.yml)
DATABASE_URL=postgresql://bytespace:bytespace@localhost:5433/bytespace?schema=public

# Direct (unpooled) connection for `prisma migrate` only. Needed with Neon (DATABASE_URL = the
# "-pooler" host, DIRECT_URL = the same URL without "-pooler"). Optional locally.
# DIRECT_URL=

# Browser origins allowed to read API responses (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (0 locally). Only set after checking the
# real hop count in production — a wrong value lets clients spoof their IP.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Signs session cookies (JWT, HS256). Required, 32+ characters: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters

# Optional rate-limit store: docker compose up -d redis → redis://localhost:6380
# Without it, limits are kept in memory (fine for a single instance).
REDIS_URL=redis://localhost:6380

# bcrypt cost (4–15). 12 in production.
BCRYPT_ROUNDS=12
