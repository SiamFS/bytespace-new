// Prisma 7 with the `prisma-client` generator: plain TypeScript generated into src/ and
// compiled with the app. ESM + ".js" import extensions to match tsconfig (NodeNext).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  /// Stored lowercased; the service normalises before every read and write.
  email        String   @unique
  /// Null for accounts created with Google sign-in (they have no password).
  passwordHash String?
  /// Google's `sub` claim — the stable account id (Google: never use the email as the id).
  googleId     String?  @unique
  /// Bumped to revoke every session of the user (checked on each authenticated request).
  tokenVersion Int      @default(0)
  /// When the email address was confirmed (verification link, or Google). Password login needs it.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verificationTokens EmailVerificationToken[]

  @@map("users")
}

/// One-time "verify your email" links. Only a SHA-256 hash of the token is stored, so a database
/// leak can't be used to verify accounts.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}
